@namespace ChartSync.Shared
@using ChartSync.Shared
@using ChartSync.Services
@inherits LayoutComponentBase
@implements IDisposable

<div class="flex h-screen bg-brand-dark text-gray-200">
  <!-- Sidebar -->
  <aside class="w-64 bg-black flex flex-col h-screen overflow-y-auto">
    <div class="p-4 font-bold text-xl text-brand">ChartSync</div>

    <!-- Nested Genre List: show after selecting a chart -->
    @if (!string.IsNullOrEmpty(ChartService.SelectedChart))
    {
      <ul class="p-4 flex-1 space-y-2">
        @foreach (var genre in GenreService.Genres)
        {
          <li>
            <button @onclick="() => OnGenreClick(genre)"
                    class="w-full text-left px-2 py-1 rounded hover:bg-gray-700"
                    style="background-color: @genre.Color">
              @genre.Name
            </button>
          </li>
        }
      </ul>
    }
  </aside>

  <!-- Main Content -->
  <div class="flex-1 flex flex-col">
    <!-- Top Navigation -->
    <nav class="bg-black p-4 flex justify-between items-center">
      <div class="text-2xl font-bold text-brand">ChartSync</div>
      <ul class="flex space-x-4">
        <li><NavLink href="/">Home</NavLink></li>
        <li><NavLink href="/dashboard">Dashboard</NavLink></li>
        <li><NavLink href="/membership">Membership</NavLink></li>
        <li><NavLink href="/account">Account</NavLink></li>
        <li><NavLink href="/about">About Us</NavLink></li>
        <li><NavLink href="/contact">Contact</NavLink></li>
        <li><NavLink href="/privacy">Privacy</NavLink></li>
      </ul>
    </nav>

    <!-- Page Body -->
    <div class="p-4 flex-1 overflow-auto">
      @Body
    </div>
  </div>
</div>

@code {
  [Inject] private ChartService ChartService { get; set; } = null!;
  [Inject] private GenreService GenreService { get; set; } = null!;
  [Inject] private AuthService AuthService { get; set; } = null!;
  [Inject] private NavigationManager NavigationManager { get; set; } = null!;

  private void OnGenreClick(Genre genre)
  {
    if (!AuthService.IsLoggedIn)
      NavigationManager.NavigateTo("/signin");
    else
    {
      GenreService.SetSelectedGenre(genre);
      NavigationManager.NavigateTo($"/genres/{genre.Slug}");
    }
  }

  protected override void OnInitialized()
  {
    ChartService.OnChange += StateHasChanged;
  }

  public void Dispose()
  {
    ChartService.OnChange -= StateHasChanged;
  }
}
